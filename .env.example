# ============================================================
# Dehradun Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL="postgresql://dehradun:dehradun_dev@localhost:5432/dehradun_dev?schema=public"

# ── API Server ───────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ── JWT / Auth (Phase 1) ─────────────────────────────────────
# JWT_SECRET=replace-with-a-secure-random-string
# JWT_EXPIRATION=3600

# ── Next.js (client-safe variables use NEXT_PUBLIC_ prefix) ──
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Staging / Production overrides ───────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# NEXT_PUBLIC_API_URL=https://api.example.com
