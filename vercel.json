{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "pnpm --filter @dehradun/prisma generate && nest build"
    }
  },
  "rewrites": [
    {
      "source": "/api/whatsapp",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/docs(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
